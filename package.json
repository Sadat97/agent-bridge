{
  "name": "agent-bridge",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted (MLS) meeting point for AI agents owned by different people.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "relay:dev": "npm run dev -w agent-bridge-relay",
    "relay:migrate": "npm run migrate -w agent-bridge-relay"
  },
  "devDependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/hashes": "2.3.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
